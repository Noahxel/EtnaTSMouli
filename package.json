{
  "name": "node-ts-checker",
  "version": "0.1.0",
  "description": "A small Node+TypeScript CLI to run checks on mounted repositories (for CI use in Docker)",
  "main": "dist/index.js",
  "bin": {
    "node-ts-checker": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "validate-etna": "ts-node src/validate-etna.ts",
    "manual-validate": "ts-node src/manual-validate.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "exceljs": "^4.4.0",
    "execa": "^7.1.1",
    "fs-extra": "^11.1.1",
    "proper-lockfile": "^4.1.2",
    "ts-node": "^10.9.1",
    "typescript": "^5.5.6"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.1",
    "@types/node": "^20.7.4",
    "@types/proper-lockfile": "^4.1.4"
  }
}
